# Lean build artifacts (toolchain pinned; rebuild via lake exe cache get)
proofs/.lake/
# JS/TS
node_modules/
dist/
.wrangler/
# Rust
target/
# Python
__pycache__/
.venv/
# Fetched dataset bytes: tracked manifests + hashes only, payloads stay local
data/snapshots/*
!data/snapshots/.gitkeep
!data/snapshots/MANIFEST.json
# Registry probe evidence (small JSON: URLs, times, hashes, licence matches) is
# tracked so PR evidence survives; raw dataset bytes stay ignored (W3b).
!data/snapshots/registry-probes/
# Secrets (NASA API key lives in services/api env)
.env
.env.*

# Reproducible planner release from the verified local assembly
apps/atlas/public/data/planner-v1/

# Browser regression artifacts
apps/atlas/test-results/
apps/atlas/playwright-report/
