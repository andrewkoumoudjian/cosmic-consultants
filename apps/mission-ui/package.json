    "pending": "node scripts/list-pending.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
