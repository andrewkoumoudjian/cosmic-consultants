{
  "name": "@cosmic-consultants/mission-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Analog Atlas: the mission-planning UI (React + Motion + globe.gl/three.js) over the shared planner engine and the planner-v1 release. No sample values.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "test:engine": "node --experimental-strip-types --test scripts/engine-results.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@noble/hashes": "2.4.0",
    "globe.gl": "2.46.2",
    "h3-js": "4.1.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
