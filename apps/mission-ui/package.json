{
  "name": "@cosmic-consultants/mission-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mission definition flow built from the team Figma file (CosmicConsultants): React + Motion + three.js. Values the pipeline doesn't publish yet are named placeholders (see src/data/pending.ts).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
