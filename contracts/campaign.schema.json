{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmic-consultants.example/contracts/campaign.schema.json",
  "title": "Past analog campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaignId",
    "name",
    "agency",
    "years",
    "site",
    "objectivesExercised",
    "publishedConstraints",
    "outcome",
    "sources",
    "nulls",
    "evidence"
  ],
  "properties": {
    "campaignId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "agency": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "years": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {
        "first": { "type": ["integer", "null"], "minimum": 1900 },
        "last": { "type": ["integer", "null"], "minimum": 1900 }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lon", "h3r4", "quote", "sourceRef"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "h3r4": { "type": "string", "pattern": "^[0-9a-f]{15}$" },
        "quote": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "objectivesExercised": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objectiveId", "text", "quote", "sourceRef"],
        "properties": {
          "objectiveId": { "type": ["string", "null"] },
          "text": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publishedConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "value", "unit", "quote", "sourceRef"],
        "properties": {
          "what": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcome": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "quote", "sourceRef"],
        "properties": {
          "kind": { "enum": ["worked", "failed", "lesson"] },
          "text": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "url", "fetchedAt", "sha256", "localPath", "licenceNote"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "fetchedAt": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "localPath": { "type": ["string", "null"] },
          "licenceNote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nulls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "description": "Verbatim support for top-level descriptive fields without their own quote fields.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "quote", "sourceRef"],
        "properties": {
          "field": { "enum": ["campaignId", "name", "agency", "years", "site.name"] },
          "quote": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
