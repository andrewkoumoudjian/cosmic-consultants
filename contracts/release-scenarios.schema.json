{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit supplementary planning examples, not accepted planetary bands",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "scenarios"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "const": "illustrative-team-assumptions"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "parameters"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limits",
              "month",
              "thermalBandK",
              "coverageRules",
              "alpha",
              "maxWeightPerSite",
              "minLandPct",
              "maxLayers",
              "maxCandidates",
              "years"
            ],
            "properties": {
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "month": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "thermalBandK": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "coverageRules": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "alpha": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "maxWeightPerSite": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minLandPct": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "maxLayers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "maxCandidates": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "years": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "origin",
                  "basis"
                ],
                "properties": {
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "origin": {
                    "enum": [
                      "team",
                      "user",
                      "target",
                      "precedent"
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
