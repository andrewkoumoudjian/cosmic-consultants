{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmic-consultants.dev/contracts/site.schema.json",
  "title": "AnalogSite",
  "description": "One candidate Earth cell/site with its per-dimension analogy vector. Mirrors Analog.Semantics.AnalogyVector: loss orientation (0 = perfect match, larger = worse); no scalar total is representable.",
  "type": "object",
  "required": ["siteId", "geometry", "analogy", "permanentMismatches", "provenance"],
  "additionalProperties": false,
  "properties": {
    "siteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "geometry": {
      "type": "object",
      "required": ["centroidLat", "centroidLon"],
      "additionalProperties": false,
      "properties": {
        "centroidLat": { "type": "number", "minimum": -90, "maximum": 90 },
        "centroidLon": { "type": "number", "minimum": -180, "maximum": 180 },
        "cellSizeKm": { "type": "number", "exclusiveMinimum": 0 },
        "polygonGeoJson": { "type": ["object", "null"] }
      }
    },
    "analogy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "loss", "breakdown"],
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["terrain", "thermal", "illumination", "dustProcess", "waterIce", "surfaceMaterial", "subsurface", "operations"]
          },
          "loss": { "type": "number", "minimum": 0 },
          "breakdown": { "type": "boolean" },
          "breakdownReason": { "type": ["string", "null"] },
          "datasetRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "permanentMismatches": {
      "type": "array",
      "items": { "type": "string", "enum": ["gravity", "pressureRegime", "radiation"] },
      "description": "Per Analog.Semantics.PermanentMismatch; all applicable entries are mandatory in dossiers (validated in review, not by schema)."
    },
    "explorationUse": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "required": ["statementLedger", "snapshots"],
      "additionalProperties": false,
      "properties": {
        "statementLedger": { "type": "string", "description": "STATEMENTS.md version/commit the scores conform to" },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["datasetId", "sourceUrl", "fetchedAt", "sha256"],
            "additionalProperties": false,
            "properties": {
              "datasetId": { "type": "string" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "fetchedAt": { "type": "string", "format": "date-time" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "license": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
